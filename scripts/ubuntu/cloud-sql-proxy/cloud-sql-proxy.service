# Cloud SQL Auth Proxy. Installed verbatim by install-cloud-sql-proxy.sh — like
# otelcol.service and unlike tomcat.service this is NOT a template and has no
# @PLACEHOLDER@ to substitute.
#
# INSTALLED BUT NOT ENABLED IN THE IMAGE. With no instance in
# /etc/cloud-sql-proxy/env the proxy exits non-zero at once, so the deploy step
# that knows the instance is what runs `systemctl enable --now`.
[Unit]
Description=Cloud SQL Auth Proxy
After=network-online.target
Wants=network-online.target

# Ordered BEFORE the app servers so a unit enabled on this box comes up first.
# This is ordering only, not a dependency: Tomcat still starts if the proxy is
# absent or disabled, which is every flavor as baked. Apps must survive the
# tunnel being down anyway (it restarts), so a Requires= here would convert a
# transient proxy failure into a dead app server.
Before=tomcat.service

[Service]
User=csqlproxy
Group=csqlproxy

Type=simple
EnvironmentFile=/etc/cloud-sql-proxy/env
# $CSP_FLAGS and $CSP_INSTANCES are UNQUOTED so systemd word-splits them into
# separate arguments — that is how the env file passes several instances.
ExecStart=/opt/cloud-sql-proxy/bin/cloud-sql-proxy $CSP_FLAGS $CSP_INSTANCES

# NO CREDENTIALS ANYWHERE. The proxy authenticates as the VM's own service
# account via the metadata server (Application Default Credentials), so there is
# no key file to bake, rotate or leak. What it needs instead is an IAM grant:
# roles/cloudsql.client for that service account on the target instance. A
# missing grant shows up as a 403 in `journalctl -u cloud-sql-proxy`, not as a
# connection refused on 3307.

Restart=always
RestartSec=10

# An empty CSP_INSTANCES (a baked image with the unit enabled by hand, and
# nothing appended) makes the proxy exit instantly; without a burst limit that
# is a tight restart loop. Five failures in a minute and systemd leaves a clean
# failed state instead.
StartLimitBurst=5
StartLimitIntervalSec=60

# --- Hardening ----------------------------------------------------------------
# This process holds an authenticated path into a production database, so it is
# worth confining. It makes outbound connections and listens on loopback; it
# reads one env file and writes nothing.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

# No capabilities. Port 3307 is unprivileged, so nothing here needs
# CAP_NET_BIND_SERVICE.
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
