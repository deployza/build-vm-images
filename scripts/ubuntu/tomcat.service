[Unit]
Description=Apache Tomcat Web Application Container
After=syslog.target network.target

[Service]
# User and group to run the service as (recommended to be a non-root user)
User=tomcat
Group=tomcat

# Type of service
Type=forking

# Environment variables (Optional, but good practice)
Environment="JAVA_HOME=/opt/java/latest"

Environment=PROCESS_NAME=tomcat

# Externalized app config + log directories under the tomcat user's home. Also
# exported (and passed as -Dconfig.dir / -Dlogs.dir) by setenv.sh; set here too
# so they are present in the service environment regardless of how Tomcat is
# invoked.
Environment=CONFIG_DIR=/home/tomcat/apps/conf
Environment=LOGS_DIR=/home/tomcat/apps/logs

Environment=CATALINA_HOME=/home/tomcat/instance
Environment=CATALINA_BASE=/home/tomcat/instance
Environment=CATALINA_PID=/home/tomcat/instance/tomcat.pid

# Commands to start and stop the service
ExecStart=/home/tomcat/instance/bin/catalina.sh start
ExecStop=/home/tomcat/instance/bin/catalina.sh stop

# Restart policy
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target