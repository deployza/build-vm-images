# Cloud SQL Auth Proxy configuration, installed verbatim by
# install-cloud-sql-proxy.sh as /etc/cloud-sql-proxy/env and read by
# cloud-sql-proxy.service.
#
# CSP_INSTANCES IS EMPTY IN THE IMAGE, ON PURPOSE. Which Cloud SQL instance a VM
# talks to is a deploy-time decision, so a baked image names none and its unit
# is not enabled. Append the instance and enable the unit at deploy time:
#
#   printf 'CSP_INSTANCES=%s\n' "my-project:asia-east1:my-instance" \
#     >> /etc/cloud-sql-proxy/env
#   systemctl enable --now cloud-sql-proxy.service
#
# Both variables are referenced UNQUOTED from ExecStart, so systemd splits them
# on whitespace into separate arguments — which is how several instances, or an
# extra flag, are passed. Do not quote the values here.

# Instance connection names: <project>:<region>:<instance>, space-separated for
# more than one. Each gets its own port, counting up from --port.
CSP_INSTANCES=

# --port 3307, NOT 3306: the mysql, tomcat-mysql and tomcat-nginx-mysql flavors
# run a local MySQL daemon on 3306, and one env file that works on every flavor
# is worth more than matching the default port. An app's JDBC URL for Cloud SQL
# is therefore jdbc:mysql://127.0.0.1:3307/<db>.
#
# --address 127.0.0.1 keeps the listener host-local. The proxy terminates an
# authenticated tunnel, so anything that can reach this port IS the database
# client — never bind it to 0.0.0.0.
#
# --health-check exposes /startup, /readiness and /liveness on the http port,
# which is what makes "is the tunnel actually up" answerable without a SQL
# client. --structured-logs so journald gets parseable JSON rather than prose.
CSP_FLAGS=--address 127.0.0.1 --port 3307 --health-check --http-address 127.0.0.1 --http-port 9091 --structured-logs
