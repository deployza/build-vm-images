# Single source of truth for pinned toolchain versions.
# Sourced by the install-*.sh scripts and surfaced as image labels (see build-design.md §9).

# Base URL the install scripts download tarballs from (installables live under
# ${FILES_BASE_URL}/installables/). The scripts source this file, so this is the
# single place to change it; each script still allows an env override via
# ${FILES_BASE_URL:-...}.
FILES_BASE_URL=${FILES_BASE_URL:-https://storage.googleapis.com/files.deployza.com}

# Java (JDK) — tarball published under ${FILES_BASE_URL}/installables/
JDK_VERSION=24
JDK_TAR_FILE=jdk-24_linux-x64_bin.tar.gz

# Apache Tomcat
TOMCAT_VERSION=11.0.8
TOMCAT_TAR_FILE=apache-tomcat-11.0.8.tar.gz

# MySQL Server (mysql-server + mysql-client from Ubuntu's own apt repo, not
# dev.mysql.com — pins to the distro's 8.0.x so the image stays stable across
# rebuilds). This is a label/description value only; the actual installed
# version is recorded in /etc/image-manifest.txt at build time.
MYSQL_VERSION=8.0

# nginx (installed from the official nginx.org stable apt repo, not Ubuntu's own
# package — matching the sibling docker image). The repo serves whatever stable
# is current for the base image's codename, so this is a label/description value
# only; the actual installed version is recorded in /etc/image-manifest.txt at
# build time.
NGINX_VERSION=stable

# Gitea (single static binary from dl.gitea.com)
GITEA_VERSION=1.22.0

# MkDocs + plugins (installed into a venv by install-mkdocs.sh, nginx flavor
# only). Pinned to MATCH www-apidocs/requirements.txt exactly — website-vm's
# docs-refresh timer runs `mkdocs build --strict` against a `www-apidocs`
# checkout, so a mismatch here means the VM builds the docs with different
# plugin versions than whoever last tested `mkdocs serve` locally. Bump both
# together, deliberately, the same way www-apidocs' own README says to.
MKDOCS_VERSION=1.6.1
MKDOCS_MATERIAL_VERSION=9.7.7
MKDOCS_AWESOME_PAGES_VERSION=2.10.1

# graphify (PyPI package `graphifyy`, installed into a venv by
# install-graphify.sh). Pinned to the version validated end to end before the
# service was built — server start, API-key auth, MCP handshake and all 10 tools.
# 0.9.49 exists upstream; bump deliberately and re-validate, not automatically.
#
# NOTE: the published docs and the repo's `main` branch both DISAGREE with the
# shipping code — branch `v8` is the only reliable reference for behaviour.
GRAPHIFY_VERSION=0.9.48

# FastMCP — the OAuth gateway in front of graphify (install-mcp.sh,
# mcp_auth_app.py). It provides Dynamic Client Registration, PKCE, token issuance
# and the bridge to Google, so it sits IN THE AUTHENTICATION PATH.
#
# Pin it harder than a normal dependency, for two reasons. It is pre-1.0 and the
# gateway imports several of its submodules directly, so a rename breaks the image
# build (the import check in install-mcp.sh exists for exactly that). And an auth
# library upgrade must be followed by re-running the whole browser login flow in all
# four clients, not just by a green build.
FASTMCP_VERSION=3.4.7

# OpenTelemetry Collector, contrib distribution (install-otel.sh). Baked on
# EVERY flavor, inert — it collects nothing until a config is pushed. Contrib,
# not core: the filelog receiver and the elasticsearch/clickhouse exporters are
# contrib-only.
#
# Downloaded as a pinned tarball from the upstream GitHub release, like the JDK
# and Tomcat. No checksum step, matching install-java.sh / install-tomcat.sh /
# install-gitea.sh.
#
# BUMPING: change the version here AND the matching OTELCOL_VERSION in
# build-app-install/otel/cloudbuild.yaml. Different repos, so that pairing is
# manual - CI validating against a version the fleet does not run is worse than
# no CI at all.
#
# 0.161.0 released 2026-09-16.
OTELCOL_VERSION=0.161.0

# CPython, built from source by install-python.sh into /opt/python/<version>
# (nginx-python flavor). Ubuntu 24.04 ships 3.12 and has no 3.14 package, so
# there is no apt route to an exact patch pin: deadsnakes is a community PPA
# that tracks "latest 3.14.x", which is precisely what a pinned image must not
# do. The python.org source tarball is the only official artifact for a named
# patch release, so this is a full X.Y.Z — bumping it rebuilds the interpreter.
PYTHON_VERSION=3.14.7
PYTHON_TAR_FILE=Python-3.14.7.tar.xz
